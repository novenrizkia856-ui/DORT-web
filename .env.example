# DORT web. Every value here is public and safe to expose in the browser, which is why they are
# all prefixed NEXT_PUBLIC_.
#
# This is a static export, so these are read at BUILD time and baked into the output. Changing one
# on Vercel does nothing until you redeploy.
#
# Almost everything below already has a working default in config/contracts.ts. Setting a variable
# here only overrides that default. There is exactly one you actually need.


# ---------------------------------------------------------------------------
# REQUIRED for mobile wallets
# ---------------------------------------------------------------------------
# Get one at https://dashboard.reown.com. Free, takes a minute.
# Leave it empty and the app still works, but the WalletConnect button is hidden
# and only browser wallets like MetaMask can connect.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=


# ---------------------------------------------------------------------------
# OPTIONAL. Deployed contracts, already baked in. Only set these to override.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_REGISTRY_ADDRESS=0x638a279363f28f7c25aa3c5132eb5b99e198e1f1
# NEXT_PUBLIC_REGISTRY_DEPLOYED_AT=58736296
# NEXT_PUBLIC_LENS_ADDRESS=0x96bf04abbbcc39e0f06cb19cf5b4df54ac949395
# NEXT_PUBLIC_LENS_DEPLOYED_AT=58736296


# ---------------------------------------------------------------------------
# OPTIONAL. Network endpoints, already baked in. Set one to use your own RPC,
# which is worth doing if the public endpoint gets rate limited.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_RPC_MAINNET=https://rpc.mainnet.chain.robinhood.com
# NEXT_PUBLIC_RPC_TESTNET=https://rpc.testnet.chain.robinhood.com
# NEXT_PUBLIC_EXPLORER_MAINNET=https://robinhoodchain.blockscout.com
# NEXT_PUBLIC_EXPLORER_TESTNET=https://explorer.testnet.chain.robinhood.com


# ---------------------------------------------------------------------------
# OPTIONAL. The token. No token has launched, so leave these alone.
# ---------------------------------------------------------------------------
# The bar at the top of the marketing page reads "Coming soon" with a disabled
# copy button until BOTH of these are set. Nothing else on the site needs
# editing when they are.
NEXT_PUBLIC_TOKEN_IS_LIVE=false
NEXT_PUBLIC_TOKEN_ADDRESS=
