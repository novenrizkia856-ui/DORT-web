# DORT web. Every value below is public and safe to expose in the browser.
# Leave a value empty until the real one exists. Nothing here is required to build.

# Token. Set NEXT_PUBLIC_TOKEN_IS_LIVE to the literal string true only once the
# token has actually launched and NEXT_PUBLIC_TOKEN_ADDRESS holds its address.
# Until then the bar at the top of the page reads "Coming soon".
NEXT_PUBLIC_TOKEN_IS_LIVE=false
NEXT_PUBLIC_TOKEN_ADDRESS=

# Protocol contracts
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_REGISTRY_DEPLOYED_AT=
NEXT_PUBLIC_LENS_ADDRESS=
NEXT_PUBLIC_LENS_DEPLOYED_AT=

# Network endpoints
NEXT_PUBLIC_EXPLORER_MAINNET=
NEXT_PUBLIC_EXPLORER_TESTNET=
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_TESTNET=
